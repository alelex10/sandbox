generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Subscription {
  id                String                  @id @default(uuid())
  method            String
  mpId              String?
  status            String?
  externalReference String?
  payerEmail        String?
  reason            String?
  amount            Float                   @default(0)
  currency          String                  @default("ARS")
  startDate         String?
  initPoint         String?
  preapprovalPlanId String?
  paymentProfileId  String?
  customerId        String?
  tokenization      String?
  rawCreate         String?
  rawLastSearch     String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?
  events            WebhookEvent[]
  charges           OrderCharge[]
  snapshots         SubscriptionSnapshot[]

  @@index([externalReference])
}

model SubscriptionSnapshot {
  id             String       @id @default(uuid())
  subscriptionId String
  kind           String
  statusAtTime   String?
  raw            String
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
}

model Plan {
  id            String          @id @default(uuid())
  mpPlanId      String?
  reason        String?
  amount        Float           @default(0)
  currency      String          @default("ARS")
  frequency     Int             @default(1)
  frequencyType String          @default("months")
  initPoint     String?
  rawCreate     String?
  rawLastSearch String?
  createdAt     DateTime        @default(now())
  deletedAt     DateTime?
  snapshots     PlanSnapshot[]
}

model PlanSnapshot {
  id           String   @id @default(uuid())
  planId       String
  kind         String   // 'create' | 'search'
  statusAtTime String?
  raw          String
  createdAt    DateTime @default(now())
  plan         Plan     @relation(fields: [planId], references: [id])

  @@index([planId])
}

model OrderCharge {
  id             String       @id @default(uuid())
  subscriptionId String
  mpOrderId      String?
  amount         Float
  status         String?
  sequenceNumber Int?
  rawResponse    String?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

model WebhookEvent {
  id             String        @id @default(uuid())
  method         String?
  topic          String
  category       String
  action         String?
  mpResourceId   String?
  rawBody        String
  rawFetched     String?
  receivedAt     DateTime      @default(now())
  deletedAt      DateTime?
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
}

model Note {
  id        String    @id @default(uuid())
  method    String
  title     String
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([method])
}

model Counter {
  name  String @id
  value Int    @default(0)
}
