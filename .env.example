# Backend secrets — never expose these to the frontend
MP_ACCESS_TOKEN=YOUR_MP_ACCESS_TOKEN_HERE
MP_NOTIFICATION_URL=https://your-ngrok-or-tunnel.example.com/webhooks/mp
MP_BACK_URL=http://localhost:5173
API_PORT=3000
DATABASE_URL="file:./prisma/dev.db"

# Frontend env vars (VITE_ prefix required by Vite)
VITE_MP_PUBLIC_KEY=YOUR_VITE_MP_PUBLIC_KEY_HERE
VITE_API_URL=http://localhost:3000
